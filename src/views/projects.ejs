<%- include('partials/header') %>
<main>
  <h1><%= title %></h1>

  <ul>
    <% projects.forEach(project => { %>
      <li>
        <%= new Date(project.date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        }) %>:
        <a href="/projects/<%= project.project_id %>"><%= project.title %></a>
        (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
        <% if (user && user.role_name === 'admin') { %>
          <p>
            <a href="/edit-project/<%= project.organization_id %>">Edit Project</a>
          </p>
        <% } %>
      </li>
    <% }) %>
  </ul>
  <% if (user && user.role_name === 'admin') { %>
    <a href="/new-project">Add New Service Project</a>
  <% } %>
</main>
<%- include('partials/footer') %>