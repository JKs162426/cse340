<%- include('partials/header') %>
<main>
  <h1><%= project.title %></h1>

  <p><strong>Description:</strong> <%= project.description %></p>
  <p>
    <strong>Date:</strong>
    <%= new Date(project.date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    }) %>
  </p>
  <p><strong>Location:</strong> <%= project.project_location %></p>
  <p>
    <strong>Organization:</strong>
    <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
  </p>

  <p><strong>Categories:</strong></p>
  <div class="category-tags">
    <% categories.forEach(category => { %>
      <a class="category-tag" href="/category/<%= category.category_id %>">
        <%= category.name %>
      </a>
    <% }) %>
  </div>
  <div class="volunteer-section">
    <% if (isLoggedIn) { %>
      <% if (isVolunteering) { %>
        <p>You are volunteering for this project.</p>
        <form action="/projects/<%= project.project_id %>/remove-volunteer" method="POST">
          <button type="submit">Remove Volunteer</button>
        </form>
      <% } else { %>
        <form action="/projects/<%= project.project_id %>/volunteer" method="POST">
          <button type="submit">Volunteer for this Project</button>
        </form>
      <% } %>
    <% } %>
  </div>

  <% if (user && user.role_name === 'admin') { %>
    <a href="/edit-project/<%= project.project_id %>">Edit Project</a><br> 
    <a href="/assign-categories/<%= project.project_id %>">Assign Categories</a>
  <% } %>
</main>
<%- include('partials/footer') %>