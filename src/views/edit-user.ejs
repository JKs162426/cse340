<%- include('partials/header') %>
<main>
  <div class="form-container">
    <h1><%= title %></h1>

    <form action="/edit-user/<%= userDetails.user_id %>" method="POST">
      <div class="form-group">
        <label for="name">User Name</label>
        <input
          type="text"
          id="name"
          name="name"
          value="<%= userDetails.user_name %>"
          maxlength="100"
          required
        />
      </div>

      <div class="form-group">
        <label for="email">User Email</label>
        <input
          type="email"
          id="email"
          name="email"
          maxlength="100"
          required
          value="<%= userDetails.user_email %>"
        />
      </div>

      <div class="form-group">
        <label for="role_id">Role</label>
        <select id="role_id" name="role_id" required>
          <option value="1" <%= userDetails.role_id === 1 ? 'selected' : '' %>>User</option>
          <option value="2" <%= userDetails.role_id === 2 ? 'selected' : '' %>>Admin</option>
        </select>
      </div>

      <div class="form-actions">
        <button type="submit">Update User</button>
        <a class="button-link" href="/registered-users">Cancel</a>
      </div>
    </form>
  </div>
</main>
<%- include('partials/footer') %>